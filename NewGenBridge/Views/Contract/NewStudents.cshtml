@model List<Lead>

<style>
    .pages-container {
        display: flex;
        margin: 1rem 0;
        padding: 0;
        list-style: none;
        justify-content: center;
        gap: 1rem;
    }

    .input-text {
        padding: 0;
        background: none;
        border: none;
        width: 100%;
    }

    .m-none {
        margin: 0;
    }

    .abs-container {
        position: relative;
    }

    #searchBar {
        width: 50%;
        position: relative;
        z-index: 1;
    }

    .drop-down-ul {
        padding: 0;
        margin: 0;
        list-style: none;
        position: absolute;
        width: 50%;
        margin-top: -.5rem;
        padding-top: .5rem;
        border: 1px solid var(--main-color);
        border-top: 0;
        box-sizing: border-box;
        z-index: 0;
        max-height: 30vh;
        overflow-y: scroll;
    }

        .drop-down-ul > li {
            background: var(--light-color);
            cursor: pointer;

            span {
                display: block;
                padding: .5rem;
            }
        }

    #li-not-found {
        padding: .5rem;
    }

    .drop-down-ul > li:hover {
        background: var(--main-color);
    }
</style>
<h2>
    @Html.T("new_user_registration")
</h2>

<div>
    @await Html.PartialAsync("_NewStudentsPartial", Model)
</div>
<script>
    var registerButtons = document.querySelectorAll(".register-button");
    registerButtons.forEach(button => {
        button.addEventListener("click", () => {
            let row = button.closest("tr");
            let data = {
                LeadId: parseInt(row.getAttribute("data-lead-id")),
                ParentName: row.querySelector("[data-lead-info='parentName']").textContent.trim(),
                FirstName: row.querySelector("[data-lead-info='firstName']").textContent.trim(),
                LastName: row.querySelector("[data-lead-info='lastName']").textContent.trim(),
                PhoneNumber: row.querySelector("[data-lead-info='phoneNumber']").textContent.trim(),
                LevelId: parseInt(row.querySelector("[data-lead-info='levelId']").value),
                GroupId: parseInt(row.querySelector("[data-lead-info='groupId']").value),
                ContractId: parseInt(row.getAttribute("data-lead-cid"))
            };
            row.style.opacity = "0.5";
            row.style.pointerEvents = "none";
            $.ajax({
                url: '@Url.Action("NewStudentFromContract", "Contract")',
                type: 'POST',
                data: data,
                success: function (response) {
                    window.location.reload();
                },
                error: function (error) {
                    alert("Error occured - try again");
                    window.location.reload();
                }
            });
        });
    });

    var deleteButtons = document.querySelectorAll(".delete-button");
    deleteButtons.forEach(button => {
        button.addEventListener("click", () => {
            if (!confirm("Are you sure you want to delete this lead?")) {
                return;
            }
            let row = button.closest("tr");
            let leadId = parseInt(row.getAttribute("data-lead-id"));
            row.style.opacity = "0.5";
            row.style.pointerEvents = "none";
            $.ajax({
                url: '@Url.Action("DeleteLead", "Contract")',
                type: 'POST',
                data: { leadId: leadId },
                success: function (response) {
                    window.location.reload();
                },
                error: function (error) {
                    alert("Error occured - try again");
                    window.location.reload();
                }
            });
        });
    });
</script>