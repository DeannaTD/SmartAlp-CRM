@using NewGenBridge.Helpers
@using NewGenBridge.Services
@inject ContractService _contractService

@model List<Contract>

@{
    if (User.IsInRole(NPUR.Admin) || User.IsInRole(NPUR.Supervisor)) Layout = "~/Views/Shared/_AdminLayout.cshtml";
    else Layout = "~/Views/Shared/_Layout.cshtml";

    var contractInfoList = ViewBag.NamesList;
}
<style>
    .contract-edit-list{
        display: flex;
        list-style: none;
        padding: 0;
        gap: 24px;
        flex-wrap: wrap;
    }

    .contract-edit-link{
        color: #2D3748;
    }

    .input-text{
        padding: 0;
        background: none;
        border: none;
        width: 100%;
    }

    .m-none{
        margin: 0;
    }

    .abs-container {
        position: relative;
    }

    #searchBar {
        width: 50%;
        position: relative;
        z-index: 1;
    }

    .drop-down-ul {
        padding: 0;
        margin: 0;
        list-style: none;
        position: absolute;
        width: 50%;
        margin-top: -.5rem;
        padding-top: .5rem;
        border: 1px solid var(--main-color);
        border-top: 0;
        box-sizing: border-box;
        z-index: 0;
        max-height: 30vh;
        overflow-y: scroll;
    }

    .drop-down-ul > li {
        background: var(--light-color);
        cursor: pointer;

        span {
            display: block;
            padding: .5rem;
        }
    }

    #li-not-found {
        padding: .5rem;
    }

    .drop-down-ul > li:hover {
        background: var(--main-color);
    }

    .pages-container{
        display: flex;
        margin: 1rem 0;
        padding: 0;
        list-style: none;
        justify-content: center;
        gap: 1rem;
    }
</style>
<h2>@Html.T("contracts")</h2>
<ul class="contract-edit-list">
@{
    <li>@Html.T("edit_contract"):</li>
    foreach (var id in ViewBag.BranchIds)
    {
        <li class="contract-edit-item">
            <a href="@Url.Action("ContractEdit", "Contract", new {branchId = id})" class="contract-edit-link">@await _contractService.GetBranchNameById(id)</a>
        </li>
    }
    bool addAction = User.IsInRole(NPUR.Admin) || User.IsInRole(NPUR.Supervisor);
}
</ul>
<div class="abs-container" tabindex="0" style="outline:none; margin-bottom: 1rem;">
    <input type="search" id="searchBar" autocomplete="off" placeholder="@Html.T("enter_student_name")" value="@(ViewBag.Name ?? "")" />
    <ul class="drop-down-ul d-none" id="searchList">
        <li id="li-not-found" class="d-none">@Html.T("nothing_found")</li>
        @foreach (var student in contractInfoList)
        {
            <li data-student="@student.StudentName">
                <span>
                    @student.StudentName
                </span>
            </li>
        }
    </ul>
</div>
<!--
FIX INSERT
-->

<div id="contract-list-container">
    @await Html.PartialAsync("_ContractTablePartial", Model)
</div>

<!--
FIX END
-->

<script>
    (function(){
        const baseUrl = "@Url.Action("ContractTable", "Contract")";
        let searchBar = document.querySelector("#searchBar");
        let searchDrop = document.querySelector("#searchList");
        let items = document.querySelectorAll('#searchList>li');
        let notFound = document.querySelector('#li-not-found');

        function loadContracts(url) {
            const fetchUrl = url || baseUrl;
            fetch(fetchUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => {
                    if (!r.ok) throw new Error('Network error');
                    return r.text();
                })
                .then(html => {
                    document.getElementById('contract-list-container').innerHTML = html;
                })
                .catch(err => {
                    console.error(err);
                });
        }

        searchBar.addEventListener('focus', () => {
            searchDrop.classList.remove('d-none');
        });

        window.addEventListener('click', (e) => {
            if (e.target != searchBar)
                searchDrop.classList.add('d-none');
        });

         searchBar.addEventListener('input', (e) => {
            let searchValue = searchBar.value.toUpperCase();
            let found = 0;
            for (const opt of items) {
                const toShow = opt.innerText.toUpperCase().includes(searchValue);
                found += toShow;
                opt.classList.toggle('d-none', !toShow);
            }
            notFound.classList.toggle('d-none', found);
        });

        searchBar.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                const value = searchBar.value.trim();
                if (!value) {
                    loadContracts(baseUrl);
                }
            }
        });

        document.getElementById('contract-list-container').addEventListener('click', function (e) {
            const link = e.target.closest('a.page-number');
            if (!link) return;
            e.preventDefault();
            const href = link.getAttribute('href');
            fetch(href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => {
                    document.getElementById('contract-list-container').innerHTML = html;
                })
                .catch(err => console.error(err));
        });

        function attachItemClickHandlers() {
            for (const item of items) {
                if (item === notFound) continue;
                item.removeEventListener('click', item._copHandler);
                item._copHandler = function () {
                    const student = item.getAttribute('data-student') || item.innerText.trim();
                    searchBar.value = item.innerText;
                    searchDrop.classList.add('d-none');
                    loadContracts(baseUrl + '?page=1&name=' + encodeURIComponent(student));
                };
                item.addEventListener('click', item._copHandler);
            }
        }
        attachItemClickHandlers();
    })();
</script>
                    