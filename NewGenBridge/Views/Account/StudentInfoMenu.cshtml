@using NewGenBridge.Helpers
@using NewGenBridge.ViewModels
@model StudentInfoViewModel
@{
    Layout = null;
}

<div class="pop-up-wrapper">
    <div class="pop-up-container wide-pop-up">
        <div class="pop-up-header">
            <h2>@Model.FirstName @Model.LastName</h2>
            <button class="close-icon" onclick="closePopUp('lesson-select-pop-up')">
                <img src="~/img/close.svg" alt="">
            </button>
        </div>
        <div class="pop-up-content">
            <form class="v-form" asp-action="UpdateStudent" asp-controller="Account"
                  data-ajax="true" data-ajax-complete="studentInfoSaved">
                <input type="hidden" asp-for="@Model.StatusId" />
                <input type="hidden" asp-for="@Model.StudentId" />
                <div class="form-grid">
                    <div class="v-form-block">
                        <label for="ParentName">@Html.T("parent_name"):</label>
                        <input asp-for="@Model.ParentName" required/>
                    </div>
                    <div class="v-form-block">
                        <label for="PhoneNumber">@Html.T("phone_number"):</label>
                        <input asp-for="@Model.PhoneNumber" required/>
                    </div>
                    <div class="v-form-block">
                        <label for="FirstName">@Html.T("first_name"):</label>
                        <input asp-for="@Model.FirstName" required/>
                    </div>
                    <div class="v-form-block">
                        <label for="LastName">@Html.T("last_name"):</label>
                        <input asp-for="@Model.LastName" required/>
                    </div>
                    <div class="v-form-block">
                        <label for="DateOfBirth">@Html.T("date_of_birth"):</label>
                        <input asp-for="@Model.DateOfBirth" required/>
                    </div>
                    <div class="v-form-block">
                        <label for="Started">@Html.T("started_on"):</label>
                        <input asp-for="@Model.Started" required/>
                    </div>
                    <div class="v-form-block">
                        <label for="Note">@Html.T("note"):</label>
                        <input asp-for="@Model.Note" />
                    </div>
                    <div class="v-form-block">
                        <label>@Html.T("level"):</label>
                        <p class="false-input">@Model.LevelName</p>
                    </div>
                    <div class="v-form-block">
                        <label for="group-select">@Html.T("group"):</label>
                        <div class="select-wrapper">
                            <select asp-for="GroupId" asp-items="@ViewBag.BranchList" id="group-select" required><option value="">@Html.W("no_group")</option></select>
                        </div>
                    </div>
                    <div class="v-form-block">
                        <label for="mentor-select">@Html.T("mentor"):</label>
                        <select asp-items="@ViewBag.GroupsMentors" id="mentor-select" disabled></select>
                    </div>
                </div>
                <input type="submit" class="action-button centered-button" value="@Html.T("save")" />
            </form>
        </div>
    </div>
</div>
<script>
    var groupSelect = document.getElementById("group-select");
    var mentorSelect = document.getElementById("mentor-select");
    mentorSelect.value = groupSelect.value;
    groupSelect.addEventListener('change', (e) => {
        mentorSelect.value = groupSelect.value;
    });

    mentorSelect.addEventListener('mousedown', (e) => { e.preventDefault() })

    studentInfoSaved = function(xhr) {
        if(xhr.status !== 200 || xhr.responseText.includes('#')) {
            new AlertBox(@Json.Serialize(Html.W("save_error")), false).show();return;
        }
        new AlertBox(@Json.Serialize(Html.W("saved")), true).show();
        closePopUp('lesson-select-pop-up');
        document.getElementById('student-filters')?.requestSubmit();
    };
</script>
