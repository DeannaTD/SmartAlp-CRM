@using NewGenBridge.Helpers
@using NewGenBridge.ViewModels
@model List<StudentManagerViewModel>
@{ ViewData["Title"] = Html.T("students");
 foreach(var item in (List<SelectListItem>)ViewBag.GroupList) {
   foreach(var day in Enum.GetNames<DayOfWeek>()) item.Text = item.Text.Replace(" " + day + " ", " · " + Html.T(day.ToLower()) + " ");
 }
}
<header class="page-heading">
 <div><h1>@Html.T("students")</h1><p>@Html.W("students_hint")</p></div>
 <button type="button" class="accent-button" id="student-add-toggle" aria-expanded="false" aria-controls="student-add-panel">@Html.T("add_new_student")</button>
</header>
<section id="student-add-panel" class="student-add-panel" hidden>
 <label for="add-student-group">@Html.W("choose_group")</label>
 <div class="student-search-toolbar"><select id="add-student-group" asp-items="ViewBag.GroupList"><option value="">—</option></select>
 <a id="add-student-open" class="accent-button" hidden data-ajax="true" data-ajax-update="#student-create-pop-up">@Html.W("continue")</a></div>
</section>
<form method="get" action="@Url.Action("Students", "Account")" class="student-filter-form" id="student-filters">
 <div class="student-filter-field student-filter-search"><label for="searchBar">@Html.T("name")</label><input type="search" name="name" id="searchBar" placeholder="@Html.T("enter_student_name")" value="@ViewBag.Name" /></div>
 <div class="student-filter-field"><label for="student-branch">@Html.T("branch")</label><select id="student-branch" name="branchId" data-selected="@ViewBag.BranchId" asp-items="ViewBag.BranchList"><option value="0">@Html.W("all_branches")</option></select></div>
 <div class="student-filter-field"><label for="student-group">@Html.T("group")</label><select id="student-group" name="groupId" data-selected="@ViewBag.GroupId" asp-items="ViewBag.GroupList"><option value="0">@Html.W("all_groups")</option></select></div>
 <div class="student-filter-field"><label for="student-status">@Html.T("status")</label><select id="student-status" name="statusId" data-selected="@ViewBag.StatusId">
 @foreach(var status in new[] {0,1,2,3}) { <option value="@status">@(status == 0 ? Html.W("all_statuses") : Html.T(UserStatus.GetName(status).ToLower()))</option> }
 </select></div>
 <div class="student-filter-buttons"><button class="secondary-button" id="student-search-submit">@Html.W("find")</button><a href="@Url.Action("Students", "Account")">@Html.W("reset")</a></div>
</form>
<div class="student-results-heading"><p>@Html.W("found_students"): <strong>@ViewBag.ResultCount</strong></p><a href="@Url.Action("NewStudents", "Contract")">@Html.W("requests")</a></div>
<p id="student-search-status" role="status" aria-live="polite"></p>
<div id="contract-list-container">@await Html.PartialAsync("_StudentsAllPartial", Model)</div>
<div class="pop-up" id="lesson-select-pop-up"></div>
<div class="pop-up" id="student-create-pop-up"></div>
<script>
function initializeStudentGroups() {
 document.querySelectorAll('#contract-list-container select[data-init]').forEach(s => { if(Number(s.dataset.init)>0) s.value=s.dataset.init; });
}
initializeStudentGroups();
function ajaxCompleted(){ document.getElementById('student-filters').requestSubmit(); }
function ajaxFailure(){ document.getElementById('student-search-status').textContent=@Json.Serialize(Html.W("save_error")); }
(() => {
 const panel=document.getElementById('student-add-panel'), toggle=document.getElementById('student-add-toggle');
 toggle.addEventListener('click',()=>{panel.hidden=!panel.hidden;toggle.setAttribute('aria-expanded',String(!panel.hidden));if(!panel.hidden)document.getElementById('add-student-group').focus();});
 document.getElementById('add-student-group').addEventListener('change',function(){const a=document.getElementById('add-student-open');a.hidden=!this.value;a.href='@Url.Action("RegisterStudent", "Account")?groupId='+encodeURIComponent(this.value);});
 document.querySelectorAll('#student-filters [data-selected]').forEach(s=>s.value=s.dataset.selected);
 const branches=@Json.Serialize(ViewBag.GroupBranches), branch=document.getElementById('student-branch'), group=document.getElementById('student-group');
 function filterGroups(){for(const option of group.options){option.hidden=option.value!=='0' && branch.value!=='0' && String(branches[option.value])!==branch.value;option.disabled=option.hidden;}if(group.selectedOptions[0]?.disabled)group.value='0';}
 branch.addEventListener('change',filterGroups);filterGroups();
 document.getElementById('contract-list-container').addEventListener('click', e=>{
  const trigger=e.target.closest('.form-trigger');if(!trigger)return;
  const row=trigger.closest('tr'),form=row.querySelector('form'),select=form.querySelector('select');
  if(!select.value || select.value==='-1'){select.focus();return;}
  if(!confirm(@Json.Serialize(Html.W("confirm_action"))+': '+trigger.textContent.trim()+'\n'+row.querySelector('td').innerText.trim()+'\n'+select.selectedOptions[0].textContent))return;
  trigger.disabled=true;
  $.ajax({type:'POST',url:form.action,data:$(form).serialize(),success:ajaxCompleted,error:()=>{trigger.disabled=false;ajaxFailure();}});
 });
})();
</script>
