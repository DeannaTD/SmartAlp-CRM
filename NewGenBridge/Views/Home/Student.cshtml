@using NewGenBridge.Helpers
@using NewGenBridge.ViewModels
@model StudentHomeViewModel
<h2>@Html.T("welcome_to_smartalp")!</h2>
<p class="sub-text">@Html.T("student_welcome_text2")</p>
<div class="student-banner">
    <p class="banner-text">
        «@Html.T("student_welcome_text0")<br />@Html.T("student_welcome_text1")»
    </p>
    <img src="../img/student-banner-person.png" alt="student avatar" class="banner-image">
</div>
<div class="student-menu">
    <div class="student-menu-card">
        <p class="sub-header label">@Html.T("need_help")</p>
        <p class="sub-text">@Html.T("contact_manager_or_mentor")</p>
        <a href="#" class="accent-button">@Html.T("contacts")</a>
    </div>
    <div class="student-menu-card">
        <div>
            <p class="bold-text label">@Html.T("your_lesson"):</p>
            <p class="sub-header">@Model.CurrentLessonName</p>
        </div>
        <p class="sub-text">@Html.T("lessons_full_list_hint")</p>
        @* <a href="@Url.Action("Lesson", "Level", new {lessonId = Model.CurrentLessonId})" class="accent-button"></a> *@
        <a href="@Url.Content("~/" + Model.CurrentLessonLink + "/lesson.pdf")" target="_blank" class="accent-button">@Html.T("go_to_lesson")</a>
    </div>
</div>
@{
    if (ViewBag.Status == UserStatus.Blocked || ViewBag.Status == UserStatus.Archived)
    {
        <script>
            let calert = new AlertBox("Your account is not active. Please, contact your manager");
            calert.show();
        </script>
    }
}