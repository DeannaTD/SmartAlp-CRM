@model Branch

@{
    Layout = null;
}
<div class="pop-up-wrapper">
    <div class="pop-up-container">
        <div class="pop-up-header">
            <button class="close-icon" onclick="closePopUp('division-menu-pop-up')">
                <img src="~/img/close.svg" alt="">
            </button>
        </div>
        <div class="pop-up-content" style="width: 500px;">
            <form class="v-form" asp-action="Update" asp-controller="Branch"
                  data-ajax="true"
                  data-ajax-begin="submitFormSpin(this)"
                  data-ajax-success="ajaxCompleted">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="DivisionId" />
                <div class="v-form-block">
                    <input asp-for="Name" placeholder="@Html.T("name")" required/>
                </div>
                <div class="v-form-block">
                    <input asp-for="Address" placeholder="@Html.T("address")" required/>
                </div>
                <div class="v-form-block">
                    <div class="select-wrapper">
                        <select asp-for="TimeZoneId" asp-items="@ViewBag.TimeZones">
                            <option value="" disabled selected>@Html.T("select_time_zone")</option>
                        </select>
                    </div>
                </div>
                <button class="action-button spinner-button">@Html.T("save")<span class="spinner"></span></button>
            </form>
            <p class="alert-note">
                @Html.T("branch_delete_note0")
                <br />@Html.T("branch_delete_note1")
            </p>
            <a href="@Url.Action("DeleteBranchCascade", "Master", new {branchId = Model.Id})"
            data-ajax="true"
            data-ajax-success="ajaxCompletedNR"
            class="danger-button full-button">@Html.T("delete")</a>
            <script>
                var dalert;
                
                ajaxCompleted = function (xhr) {
                    let calert = new AlertBox(xhr, true);
                    calert.show();
                }

                ajaxCompletedNR = function (xhr) {
                    dalert.update(xhr);
                    dalert.makeButton();
                }
                
                document.querySelector('.danger-button').addEventListener('click', (e) => {
                    if (!confirm("Are you sure?")) e.preventDefault();
                    else {
                        dalert = new AlertBox("This process may take some time. Please, do not reload the page",
                        true, true);
                        dalert.show();
                    }
                })
            </script>
            <div>
            </div>
        </div>
