@using NewGenBridge.Helpers
@model KitRequest

<div class="pop-up-wrapper">
    <div class="pop-up-container">
        <div class="pop-up-header">
            <button class="close-icon" onclick="closePopUp('division-menu-pop-up')">
                <img src="~/img/close.svg" alt="">
            </button>
        </div>
        <div class="pop-up-content">
            <form class="v-form b-form" asp-action="CreateKitRequest" asp-controller="Branch"
                  data-ajax="true"
                  data-ajax-begin="submitFormSpin(this)"
                  data-ajax-complete="ajaxCompleted">
                <input type="hidden" asp-for="CompanyId" value="@ViewBag.CompanyId"/>
                <input type="hidden" asp-for="CreatedById" value="@User.Identity.Name" />
                <div class="v-form-block">
                    <label>@Html.T("request_date")</label>
                    <input type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
                </div>
                <div class="v-form-block">
                    <label>@Html.T("amount_of_kits")</label>
                    <input id="divisionName" asp-for="Amount" value="1" required />
                </div>
                <div class="v-form-block">
                    <label>@Html.T("request_for")</label>
                    <input value="@ViewBag.CompanyName" readonly />
                </div>
                <button class="action-button spinner-button">@Html.T("create")<span class="spinner"></span></button>
            </form>
        </div>
        <script>
            ajaxCompleted = function (xhr){
                if (xhr.responseText.includes('#')) {
                    let calert = new AlertBox(xhr.responseText, false);
                    calert.show();
                }
                else {
                    let calert = new AlertBox(xhr.responseText, true);
                    calert.show();
                }
            }
        </script>
</<div>
</div>
