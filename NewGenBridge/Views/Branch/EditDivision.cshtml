@model Division

@{
    Layout = null;
}
<div class="pop-up-wrapper">
    <div class="pop-up-container">
        <div class="pop-up-header">
            <button class="close-icon" onclick="closePopUp('division-menu-pop-up')">
                <img src="~/img/close.svg" alt="">
            </button>
        </div>
        <div class="pop-up-content" style="width: 500px;">
            <form class="v-form" asp-action="UpdateDivision" asp-controller="Branch"
                  data-ajax="true"
                  data-ajax-begin="submitFormSpin(this)"
                  data-ajax-success="ajaxCompleted">
                  <input type="hidden" asp-for="Id" />
                  <div class="v-form-block">
                      <input asp-for="Name" placeholder="Name" required/>
                  </div>
                  <button class="action-button spinner-button">Save<span class="spinner"></span></button>
            </form>
            <p class="alert-note">
                Note: deleting a non-empty division will result in losing data of branches, employees and students.
                <br />Before proceeding, make sure that no branch records are displaying in the menu.
            </p>
            <a href="@Url.Action("DeleteDivisionCascade", "Master", new {divisionId = Model.Id})"
            data-ajax="true"
            data-ajax-success="ajaxCompletedNR"
            class="danger-button full-button">Delete</a>
            <script>
                var dalert;

                ajaxCompleted = function (xhr) {
                    let calert = new AlertBox(xhr, true);
                    calert.show();
                }

                ajaxCompletedNR = function (xhr) {
                    dalert.update(xhr);
                    dalert.makeButton();
                }

                document.querySelector('.danger-button').addEventListener('click', (e) => {
                    if (!confirm("Are you sure?")) e.preventDefault();
                    else {
                        dalert = new AlertBox("This process may take some time. Please, do not reload the page",
                            true, true);
                        dalert.show();
                    }
                })
            </script>
        <div>
    </div>
</div>